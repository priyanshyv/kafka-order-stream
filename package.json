{
  "name": "flexipill-stream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learning Kafka by rebuilding the flexipill-core order flow as a message stream",
  "scripts": {
    "topics": "NODE_NO_WARNINGS=1 tsx src/tools/topics.ts",
