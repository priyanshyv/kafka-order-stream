    "email": "NODE_NO_WARNINGS=1 tsx src/consumers/email.service.ts",
    "inventory": "NODE_NO_WARNINGS=1 tsx src/consumers/inventory.service.ts",
    "analytics": "NODE_NO_WARNINGS=1 tsx src/consumers/analytics.service.ts",
    "fraud": "NODE_NO_WARNINGS=1 tsx src/consumers/fraud.service.ts",
    "zoho": "NODE_NO_WARNINGS=1 tsx src/consumers/zoho.service.ts",
    "dlq": "NODE_NO_WARNINGS=1 tsx src/consumers/dlq.inspector.ts",
    "seed": "NODE_NO_WARNINGS=1 tsx src/tools/seed.ts",
    "offsets": "NODE_NO_WARNINGS=1 tsx src/tools/offsets.ts",
    "reset": "NODE_NO_WARNINGS=1 tsx src/tools/reset.ts",
